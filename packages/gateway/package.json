{
  "name": "@shakystar/memorize-hub-gateway",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "shakystar",
  "description": "memorize Hub control-plane gateway — public edge: account auth (API keys + GitHub OAuth session), workspace/membership/invite control-plane, personal store, and a reverse proxy to the dumb relay. Clean rebuild for cross-account workspaces (see docs/protocol/ + docs/SoT/).",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && pnpm build:css",
    "build:css": "tailwindcss -i assets/app.css -o dist/public/app.css --minify",
    "dev:css": "tailwindcss -i assets/app.css -o dist/public/app.css --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "eslint": "^10.2.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
